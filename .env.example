# ── LLM Provider ──────────────────────────────────────────────────────────────
# "anthropic"  → Anthropic API (default, works out of the box)
# "openai"     → Any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio)
# "lava"       → Lava API (https://api.lava.so/v1) — hosted models via Lava
LLM_PROVIDER=anthropic

# ── Anthropic (default) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── vLLM (high-throughput GPU inference) ──────────────────────────────────────
# Start vLLM: python -m vllm.entrypoints.openai.api_server \
#   --model Qwen/Qwen2.5-Coder-7B-Instruct \
#   --quantization awq \          ← fits in 12GB VRAM (4070)
#   --max-model-len 8192
#
# LLM_PROVIDER=openai
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# OPENAI_COMPAT_API_KEY=token

# ── Ollama (easiest local setup) ──────────────────────────────────────────────
# ollama pull qwen2.5-coder:7b
# ollama serve
#
# LLM_PROVIDER=openai
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=qwen2.5-coder:7b
# OPENAI_COMPAT_API_KEY=ollama

# ── Lava API (hosted inference, pay-as-you-go) ────────────────────────────────
# Get your access token at https://www.lava.so
#
# LLM_PROVIDER=lava
# LAVA_API_KEY=your-lava-access-token
# LAVA_BASE_URL=https://api.lava.so/v1
# LAVA_MODEL=deepseek-chat
